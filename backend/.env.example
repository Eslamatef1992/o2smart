# Copy to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# From /root/o2smart_credentials.txt after running server_setup.sh
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=o2smart
DB_USER=o2smart_app
DB_PASSWORD=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Email (for passwordless OTP login) — e.g. an SMTP relay or a transactional
# email provider's SMTP credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="O2 Smart <no-reply@o2smart.example>"

# Google OAuth (for "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sadad payment gateway (sandbox first — see build-spec.md §8)
SADAD_BASE_URL=
SADAD_API_KEY=
SADAD_API_SECRET=
SADAD_WEBHOOK_SECRET=

# Frontend origin, for CORS
CORS_ORIGIN=http://localhost:5173
